@inproceedings{liu2022testing,
  title={Testing thresholds for high-dimensional sparse random geometric graphs},
  author={Liu, Siqi and Mohanty, Sidhanth and Schramm, Tselil and Yang, Elizabeth},
  booktitle={Proceedings of the 54th Annual ACM SIGACT Symposium on Theory of Computing},
  pages={672--677},
  year={2022},
  note={
  Ils utilisent une matrice d'adjacence transformée (pas simplement binaire) pour mieux représenter les relations entre individus. L'objectif est de détecter des communautés dans des graphes attribués en combinant à la fois la structure du graphe et les attributs des nœuds. 

  Ils cherchent ainsi des groupes de nœuds à la fois bien connectés entre eux et partageant des attributs similaires. Permet d'augmenter l'importance accordée à certains liens au sein d'une communauté, alors que les liens entre communautés seront plus faibles.  
  -> des liens importants auront des valeurs plus grandes.  
  -> les liens moins importants auront des valeurs basses voire nulles.
  + quelques preuves sur du calcul matriciel pour justifier les mises à jour.
  +  Ils décomposent la matrice d'attributs en un produit de deux matrices à valeurs positives (méthode NMF), afin d'obtenir des degrés d'appartenance aux communautés.
  +  Une sélection est effectuée sur les attributs pour limiter l'impact des attributs moins utiles.

  }
}

@misc{mao2026randomgeometricgraphssmooth,
      title={Random geometric graphs with smooth kernels: sharp detection threshold and a spectral conjecture}, 
      author={Cheng Mao and Yihong Wu and Jiaming Xu},
      year={2026},
      eprint={2602.14998},
      archivePrefix={arXiv},
      primaryClass={math.PR},
      url={https://arxiv.org/abs/2602.14998}, 
      note={
              
        Problème de détection, ils s'intéressent à savoir si un graphe aléatoire géométrique (RGG) avec un smooth kernels, donc l'espace latent est une sphère unité en haute dimension est discernable d'un graphe d'Erdos-Renyi. 

        Ils trouvent dans le régime dense le seuil de détection. La preuve utilisée une idée qui n'est pas générique, ils analysent la loi à posteriori des variables latentes.

        Ce papier est lié aux avancées récentes sur les RGG et les méthodes d'analyses employées et non à la détection de communautés.
      }
}

@article{meliot2019asymptotic,
  title={Asymptotic representation theory and the spectrum of a random geometric graph on a compact Lie group},
  author={M{\'e}liot, Pierre-Lo{\"\i}c},
  year={2019},
  note={
    Dans le papier, on prend un groupe de Lie compact ou plus largement,  certains espaces symétriques compacts (comme SU(n),USp(n) ou Spin(n)), on y tire N points aléatoires selon la mesure de Haar, puis on connecte deux points si leur distance géodésique est inférieure à un seuil L et on cherche à comprendre ce  que devient le spectre de ce graphe quand N -> infty et on montre que la réponse dépend fortement du régime dans lequel on fait tendre L.

    Il cherche à comprendre, par la théorie des représentations, la structure spectrale des RGG sur des groupes de Lie compacts à la fois dans un régime dense et dans un régime sparse.
  }
}

@article{peche2020robustness,
  title={Robustness of community detection to random geometric perturbations},
  author={P{\'e}ch{\'e}, Sandrine and Perchet, Vianney},
  journal={Advances in Neural Information Processing Systems},
  volume={33},
  pages={17827--17837},
  year={2020},
  note={
      Ils vérifient si les méthodes spectrales classiques de détection de communautés restent fiables sur un SBM perturbé par une componsante géométrique, un kernel gaussien. Les points vivent dans un espace latent, R2, disposés de manière gaussienne.  

    Ce cadre ne se veut pas général mais viable à l'analyse. Ils traitent le régime dense. Aucun seuil limite informationelle n'est donnée.

    Des condtions suffisantes spectrales sont données pour la Récupération Partielle, asymptotiquement Exacte et également Soft, selon si l'on connait les probabilités des blocs.

    Pour cette dernière, ils utilisent la corrélation élevée (le deuxième vecteur propre de la matrice d'adjacence reste corrrélé au veritable vecteur des communautés.)
  }
}

