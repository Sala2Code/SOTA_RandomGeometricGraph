@inproceedings{valdivia2019latent,
  title={Latent distance estimation for random geometric graphs.},
  author={Valdivia, Ernesto Araya and De Castro, Yohann},
  booktitle={NeurIPS},
  pages={8721--8731},
  year={2019},
  note={
      Dans le papier,  on part d'un graphe qui a été généré par un modèle géométrique latent dont les sommets ont été reliés avec une probabilité qui dépend d'une fonction  inconnue de leur distance  f(<XXi,Xj>).

    L'objectif est donc de la reconstrurction de cette géométriee cachée du graphe (donc la construction de la matrice de Gram G=<Xi,Xj>ij / n).

    L'apport principal du papier est donc de proposer une méthode spectrale non paramétrique qui reconstruit la structure géométrique cachée sans connaître explicitement la fonction de lien, tout en obtenant un taux de convergence du bon ordre minimax à un facteur logarithmique près. 
    }
}

@article{gaudio2026exact,
  title={Exact Recovery in the Geometric Hidden Community Model},
  author={Gaudio, Julia and Jin, Andrew},
  journal={arXiv preprint arXiv:2601.17591},
  year={2026},
  note={
      L'analyse porte sur Récupération Exacte dans une version encore plus générale du Geometric Hidden Community Model (GHCM), un modèle qu'ils ont défini 2 ans plus tôt. Ainsi, ils généralisent leur modèle afin que la loi des observations entre deux sommets dépend à la fois de leurs labels et maintenant de leur distance.

    Ils caractérisent le seuil théorique de récupération exacte dans le régime logarithmique, toujours en termes de divergence de Chernoff-Hellinger et montrent qu'un algorithme polynomial inspiré de leurs travaux précédents atteint ce seuil. En revanche, il reste soumis à des hypothèses contraignantes appelées "distinctness" déjà présentes dans la littérature GHCM.
  }
}

